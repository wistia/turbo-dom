  "scope": "Resolve three further review findings in CSS comment parsing, cached CSSOM writes, and typed-event initialization. Custom-element lifecycle and previously documented DOM limitations remain excluded.",
  "fixes": [
    {
      "finding": "Cached standard CSSOM writes bypass whitespace normalization",
      "resolution": "Trim standard-property values before retaining them as cached parsed state. Preserve existing custom-property write whitespace and existing important priority flags.",
      "regressions": [
        "setProperty standard values match jsdom and reparsed attributes",
        "Property assignments normalize whitespace without changing priority",
        "Custom-property write whitespace remains intact"
      ]
    },
    {
      "finding": "Quotes and delimiters inside CSS comments swallow following declarations",
      "resolution": "Skip comment contents during declaration tokenization, remove standard-property comments, and preserve comment tokens inside custom-property values. Quoted comment-looking strings remain literal. Inline CSSOM and computed-style declaration parsing share the scanner.",
      "regressions": [
        "Quotes, brackets and semicolons in comments cannot change scanner state",
        "Inline computed values survive comments",
        "Unterminated comments preserve earlier declarations",
        "Custom-property comment tokens and quoted text remain literal"
      ]
    },
    {
      "finding": "Typed event allowlist drops valid pointer orientation and input transfer fields",
      "resolution": "Retain altitudeAngle and azimuthAngle for pointer events and dataTransfer for input events, with defaults. Unknown-member filtering remains unchanged.",
      "regressions": [
        "Explicit pointer angles and defaults",
        "Paste/drop DataTransfer identity and text contents",
        "Existing unknown getter fields remain unread"
      ]
    }
  ],
