  "scope": "Four correctness findings and three optimization opportunities from the follow-up review. Custom-element lifecycle and known preexisting form/template ownership limitations remain excluded.",
  "fixes": [
    {
      "finding": "cssText corrupts semicolons inside CSS values",
      "resolution": "Share a quote-, escape- and delimiter-aware declaration scanner between inline CSSOM and computed-style parsing.",
      "tests": [
        "Quoted data URLs and strings",
        "Escaped quote/semicolon tokens and nested functions/brackets/braces",
        "Inline and stylesheet computed values"
      ]
    },
    {
      "finding": "Typed event initialization assigns to getter-only defaultPrevented",
      "resolution": "Read only declared typed-event dictionary fields, including inherited UI/mouse/modifier fields; ignore unknown/output-only Event members.",
      "tests": [
        "All 11 typed event constructors ignore unknown getter properties without reading them",
        "Cancellation remains functional",
        "Inherited fields remain available",
        "Existing derived MessageEvent readonly getter regression still passes"
      ]
    },
    {
      "finding": "Replacing onmessage changes listener ordering",
      "resolution": "Retain one lazy registered wrapper for each message event property; update its callback without re-registering. Null assignment removes the wrapper.",
      "tests": [
        "Both message and messageerror ordering",
        "Null removal/re-activation and reset",
        "Removal during dispatch"
      ]
    },
    {
      "finding": "Discarded srcdoc windows receive queued messages",
      "resolution": "Verify the cached frame entry and current srcdoc remain active, in addition to existing parent generation/document/connectivity guards. Nested frames inherit the same liveness guard.",
      "tests": [
        "Discarded child and descendant messages are dropped",
        "Current replacement child still receives messages",
        "Changing srcdoc invalidates delivery even before reading the replacement contentWindow"
      ]
    }
  ],
  "optimizations": [
    {
      "change": "Cache parsed/serialized inline styles by their raw attribute string",
      "invalidation": "Every read compares the current raw attribute; CSSOM writes update the cached parsed state and serialization. Regression tests cover direct attributes, CSSOM writes/removal, priorities, and removal of the whole attribute."
    },
    {
      "change": "Allocate the iframe WeakMap only when contentWindow is first requested",
      "measurement": "Removes one eager allocation per environment without frames; no isolated throughput claim."
    },
    {
      "change": "Initialize template content lazily",
      "measurement": "Parsed inflation and deep cloning can install their existing fragment without first allocating a fragment that is immediately discarded; no isolated throughput claim."
    }
  ],
